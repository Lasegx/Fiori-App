managed implementation in class zbp_r_spac108_stock unique;
strict ( 2 );
with draft;

define behavior for ZR_SPAC108_STOCK alias Stock
persistent table zspac108_stock
draft table zspac108_stock_d
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  create;
  update;
  delete;

  field ( mandatory : create ) WarehouseId, ProductId;
  field ( readonly : update )  WarehouseId, ProductId;
  field ( readonly ) LocalCreatedBy, LocalCreatedAt,
                     LocalLastChangedBy, LocalLastChangedAt, LastChangedAt;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  mapping for zspac108_stock
  {
    WarehouseId        = warehouse_id;
    ProductId          = product_id;
    Amount             = amount;
    LocalCreatedBy     = local_created_by;
    LocalCreatedAt     = local_created_at;
    LocalLastChangedBy = local_last_change_by;
    LocalLastChangedAt = local_last_change_at;
    LastChangedAt      = last_change_at;
  }
}