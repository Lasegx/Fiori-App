projection;
strict ( 2 );
use draft;

define behavior for ZC_SPAC108_WAREHOUSE alias Warehouse
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Stock { create; with draft; }
}

define behavior for ZC_SPAC108_STOCK alias Stock
{
  use update;
  use delete;

  use association _Warehouse { with draft; }
}